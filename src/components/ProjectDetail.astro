---
// Full project story, rendered at build time into a <template>. carousel.ts clones it into the
// modal on open, so screenshots inside are only fetched when someone opens this project.
import { Picture } from "astro:assets";
import type { Project } from "../data/projects";
import Chips from "./Chips.astro";
import Metrics from "./Metrics.astro";
interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const hasDemo = /^https?:\/\//.test(p.demo ?? "");
// Grid: first shot spans the modal width (max 776px of content), the rest share a row.
const sizes = ["(max-width: 940px) 84vw, 776px", "(max-width: 600px) 84vw, (max-width: 940px) 42vw, 382px"];
---
<template id={`pd-${index}`}><span class="bd">{p.badge}</span><h2 style="font-size:clamp(2rem,4.6vw,3.4rem)">{p.title}</h2><p class="tg">{p.tag}</p>{p.role && <p class="rl">Role · {p.role}</p>}<p>{p.lead}</p>{p.shots && <div class="shots">{p.shots.map((s, k) => <a href={s.src.src} target="_blank" rel="noopener"><Picture src={s.src} alt={s.alt} formats={["avif", "webp"]} fallbackFormat="jpg" widths={k === 0 ? [480, 800, 1200, 1552] : [400, 640, 900]} sizes={sizes[k === 0 ? 0 : 1]} quality={70} loading="lazy" decoding="async" /></a>)}</div>}<h4>{p.metrics || p.facts ? "Highlights" : "Features"}</h4><ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>{p.facts && <><h4>Key facts</h4><Metrics rows={p.facts} /></>}{p.metrics && <><h4>Results</h4><Metrics rows={p.metrics} /><p style="font-size:13px;color:#cfcfcf;margin-top:10px;font-style:italic">{p.metricsNote}</p></>}<h4>Tech stack</h4><Chips items={p.stack} />{p.link && <><br /><a class="lk" href={p.link.href} target="_blank" rel="noopener">{p.link.label} ↗</a></>}{hasDemo && <a class="lk lk2" href={p.demo} target="_blank" rel="noopener">Live demo ↗</a>}</template>
